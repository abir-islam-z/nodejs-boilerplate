{
  "name": "expressjs-app",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
